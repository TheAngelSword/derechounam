# Variables de ejemplo. No pongas secretos reales en este archivo.

# Portal público (derechounam.com)
DATABASE_URL=
BETTER_AUTH_URL=https://derechounam.com
APP_PUBLIC_URL=https://derechounam.com
VITE_PUBLIC_HOSTNAME=derechounam.com
BETTER_AUTH_SECRET=
VITE_AUTH_ENABLED=true

# Espacio personal en pnota.com. Ver ESPACIO-PERSONAL.md.
# En un proyecto aparte, BETTER_AUTH_URL y APP_PUBLIC_URL también son https://pnota.com
# y SITE_MODE=personal. No definas un dominio de cookie: la sesión usa cookies __Host-.
PERSONAL_PUBLIC_URL=https://pnota.com
PORTAL_PUBLIC_URL=https://derechounam.com
SITE_MODE=
VITE_PERSONAL_HOSTNAME=pnota.com
VITE_SITE_MODE=
PERSONAL_OWNER_EMAILS=
PERSONAL_ICS_TOKEN=
CRON_SECRET=

WHATSAPP_PROVIDER=
WHATSAPP_TO=
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_MODE=text
WHATSAPP_CLOUD_TEMPLATE_NAME=
WHATSAPP_CLOUD_TEMPLATE_LANG=es_MX
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_OWNER_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
